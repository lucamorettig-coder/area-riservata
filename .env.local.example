# Airtable Configuration
# Copia questo file in .env per testare localmente
# In produzione, configura queste variabili nelle Environment Variables di Webflow

# ID del Base Airtable
AIRTABLE_BASE_ID=appszpkU1aXb3xrFM

# Personal Access Token di Airtable (sostituisci con il tuo token reale)
AIRTABLE_TOKEN=pat_your_token_here
